<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Feedback - <%= sitesettings.sitename %></title>
        <meta property="og:title" content="Feedback - <%= sitesettings.sitename %>" />
        <link rel="icon" href="/assets/logo.png">
        <meta property="og:image" content="/assets/logo.png">
        <meta name="theme-color" content="<%= sitesettings.sitecolor %>">
        <meta name="description" content="<%= sitesettings.sitedesc %>" />
        <meta property="og:type" content="website" />
        <meta property="og:description" content="<%= sitesettings.sitedesc %>" />
        <meta name="keywords" content="<%= config.seoKeywords %>" />
    </head>
    <body>
        <%- include('_header') %>
        <div class="container bg-navbar p-3 text-center borderradius mt-5 mb-5 homecolumnfirsthr">
            <h1>Leave Feedback</h1>
            <hr>
            <form action="/backend/create/feedback" class="text-start mt-5" method="post">
                <label for="email">User Email:</label>
                <input type="text" name="email" placeholder="Email" class="form-control mb-3 lockedinput" value="<%= user.email %>" disabled required>
                <label for="content">Feedback Message:</label>
                <textarea name="content" class="form-control mb-3" rows="6" required placeholder="Your feedback message here..."></textarea>
                <button type="submit" class="btn btn-theme w-100">Submit Feedback</button>
            </form>
        </div>
        <%- include('_footer') %>
    </body>
</html>
