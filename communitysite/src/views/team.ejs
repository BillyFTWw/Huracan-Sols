<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Team - <%= sitesettings.sitename %></title>
        <meta property="og:title" content="Team - <%= sitesettings.sitename %>" />
        <link rel="icon" href="/assets/logo.png">
        <meta property="og:image" content="/assets/logo.png">
        <meta name="theme-color" content="<%= sitesettings.sitecolor %>">
        <meta name="description" content="<%= sitesettings.sitedesc %>" />
        <meta property="og:type" content="website" />
        <meta property="og:description" content="<%= sitesettings.sitedesc %>" />
        <meta name="keywords" content="<%= config.seoKeywords %>" />
    </head>
    <body>
        <%- include('_header') %>
        <div class="container text-center mt-5 mb-5 homecolumnfirsthr">
            <h1>Community Owners</h1>
            <hr>
            <div class="mt-5 mb-5 row justify-content-center">
                <% team.forEach(function(item) { %>
                    <% if(item.isowner) { %>
                        <div class="col-lg-3 mb-4">
                            <div class="bg-navbar p-3 borderradius bordersetup bd-theme">
                                <img src="/images/team_<%= item.id %>.png" class="teamimage mb-3 bordersetup bd-theme">
                                <h4><%= item.name %></h4>
                                <hr>
                                <small><span class="text-theme"><%= item.title %></span></small>
                                <p class="mt-2"><%= item.about %></p>
                            </div>
                        </div>
                    <% }; %>
                <% }); %>
            </div>
            <br>
            <h1>Our Staff Team</h1>
            <hr>
            <div class="mt-5 row justify-content-center">
                <% team.forEach(function(item) { %>
                    <% if(!item.isowner) { %>
                        <div class="col-lg-3 mb-4">
                            <div class="bg-navbar p-3 borderradius bordersetup bd-theme">
                                <img src="/images/team_<%= item.id %>.png" class="teamimage mb-3 bordersetup bd-theme">
                                <h4><%= item.name %></h4>
                                <hr>
                                <small><span class="text-theme"><%= item.title %></span></small>
                                <p class="mt-2"><%= item.about %></p>
                            </div>
                        </div>
                    <% }; %>
                <% }); %>
            </div>
        </div>
        <%- include('_footer') %>
    </body>
</html>
